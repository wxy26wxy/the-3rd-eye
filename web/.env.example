# Names only; real values live in Vercel and in web/.env.local (never committed).
# `vercel env pull .env.local` fills them. See docs/architecture.md for what each one does.
META_API_KEY=
OLLAMA_BASE_URL=
AI_STORY=
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=
BLOB_PRIVATE_STORE_ID=
CREATOR_SESSION_SECRET=
ADMIN_PASSWORD=
# Lets the web create flow call a protected preview deployment's API (x-vercel-protection-bypass).
VERCEL_AUTOMATION_BYPASS_SECRET=
# Public site root for story-tag links, QR codes and admin sign-in links. Leave empty locally
# (the request host is used). Production: https://the-3rd-eye.vercel.app
# (iOS names the same host once, as DEPLOYED_SITE_URL in ios/project.yml).
NEXT_PUBLIC_SITE_URL=
AI_FIXTURES=
FFMPEG_PATH=
